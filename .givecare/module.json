{
  "schema_version": "givecare.module/v2",
  "repository": "gc-evals",
  "owns": "Public eval records and instrument distribution",
  "check": "scripts/check.sh",
  "produces": [
    {"id": "gc-evals.gold-case/v1", "path": "data/all.jsonl", "for": ["gc-bench"]},
    {"id": "evals.gold-cases.apply", "path": "docs/evidence.md", "for": ["gc-sms"], "gate": "human"}
  ],
  "consumes": [
    {"id": "@givecare/tools.InstrumentExport", "from": "gc-tools"},
    {"id": "care.learning.propose", "from": "gc-sms"},
    {"id": "givecare.protocol", "from": "."}
  ]
}
