{
  "schemaVersion": 1,
  "stateDir": ".clawpatch",
  "include": [
    "data/**",
    "scripts/**",
    "CHARTER.md",
    "VISION.md",
    "CLAUDE.md",
    "CODEMAP.md",
    "README.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CITATION.cff",
    "docs/**"
  ],
  "exclude": [
    ".git/**",
    ".clawpatch/**",
    ".claude/**",
    ".codex/**",
    ".ruff_cache/**",
    "__pycache__/**",
    "node_modules/**",
    ".env*",
    "*.log",
    "*.backup",
    "*.bak",
    "*.zip"
  ],
  "provider": {
    "name": "codex",
    "model": null,
    "reasoningEffort": null
  },
  "commands": {
    "typecheck": null,
    "lint": null,
    "format": null,
    "test": "python3 scripts/validate.py"
  },
  "review": {
    "maxContextFiles": 18,
    "maxOwnedFiles": 10,
    "maxFindingsPerFeature": 8,
    "minConfidenceToFix": "medium"
  },
  "git": {
    "requireCleanWorktreeForFix": true,
    "commit": false,
    "openPr": false
  }
}
